uniform float timeSeconds;
uniform float frequencyHz;
uniform float amplitude;
layout(color) uniform float4 colorA;
layout(color) uniform float4 colorB;
half4 main(float2 p) {
    float phase = 6.28318530718 * frequencyHz * timeSeconds;
    float blend = 0.5 + amplitude * sin(0.035 * p.x + 0.022 * p.y + phase);
    float4 straight = mix(colorA, colorB, blend);
    return half4(straight.rgb * straight.a, straight.a);
}
