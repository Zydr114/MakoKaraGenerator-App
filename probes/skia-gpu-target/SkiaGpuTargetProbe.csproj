<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../backend/src/MakoKaraGenerator.Rendering.Skia/MakoKaraGenerator.Rendering.Skia.csproj" />
    <ProjectReference Include="../../backend/src/MakoKaraGenerator.Runtime.Hosting/MakoKaraGenerator.Runtime.Hosting.csproj" />
  </ItemGroup>
  <Target Name="CopyMatchedGpuNativeLibraries" AfterTargets="Build">
    <Copy SourceFiles="../../.local/skia-p0/libSkiaSharp.so;../../native/gpu-preview/build/libmako_gpu_preview.so" DestinationFolder="$(TargetDir)" />
    <Copy SourceFiles="../../.local/skia-p0/libSkiaSharp.so" DestinationFolder="$(TargetDir)runtimes/linux-x64/native" />
    <Copy SourceFiles="../../.local/skia-p0/libmako-gpu-validation.so" DestinationFolder="$(TargetDir)" Condition="Exists('../../.local/skia-p0/libmako-gpu-validation.so')" />
  </Target>
</Project>
