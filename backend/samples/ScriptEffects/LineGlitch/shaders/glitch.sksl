uniform float timeSeconds;
uniform float strengthPx;
uniform float sliceHeightPx;
uniform float frequencyHz;
uniform shader original;
half4 main(float2 p) {
    float slice = floor(p.y / sliceHeightPx);
    float tick = floor(timeSeconds * frequencyHz);
    float noise = fract(sin(slice * 12.9898 + tick * 7.233 + 1.0) * 43758.5453);
    float displacement = (2.0 * noise - 1.0) * strengthPx;
    return original.eval(p + float2(displacement, 0.0));
}
