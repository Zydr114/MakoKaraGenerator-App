set(MAKO_PRESENTATION_WINDOWS_DEVKIT_ARCHIVE "" CACHE FILEPATH "Pinned LGPL FFmpeg 9.0.2 Windows x64 devkit")
set(ffmpeg_archive_sha256 "a707bed50c7d5ccb3f2d62ee229eadf515b7f6f40f783b9db60c72afb898b7bb")
if(NOT EXISTS "${MAKO_PRESENTATION_WINDOWS_DEVKIT_ARCHIVE}")
  message(FATAL_ERROR "Set MAKO_PRESENTATION_WINDOWS_DEVKIT_ARCHIVE to the pinned FFmpeg archive (see README.md).")
endif()
file(SHA256 "${MAKO_PRESENTATION_WINDOWS_DEVKIT_ARCHIVE}" actual_archive_sha256)
if(NOT actual_archive_sha256 STREQUAL ffmpeg_archive_sha256)
  message(FATAL_ERROR "FFmpeg Windows devkit SHA-256 mismatch.")
endif()

set(ffmpeg_devkit "${CMAKE_CURRENT_BINARY_DIR}/ffmpeg-${ffmpeg_archive_sha256}")
set(windows_tool_dir "${CMAKE_CURRENT_BINARY_DIR}/media-tools")
set(ffmpeg_dlls avutil-61.dll avcodec-63.dll avformat-63.dll)
file(MAKE_DIRECTORY "${ffmpeg_devkit}")
file(ARCHIVE_EXTRACT INPUT "${MAKO_PRESENTATION_WINDOWS_DEVKIT_ARCHIVE}" DESTINATION "${ffmpeg_devkit}")
file(MAKE_DIRECTORY "${windows_tool_dir}")
foreach(dll IN LISTS ffmpeg_dlls)
  file(COPY_FILE "${ffmpeg_devkit}/bin/${dll}" "${windows_tool_dir}/${dll}" ONLY_IF_DIFFERENT)
endforeach()
foreach(notice IN ITEMS FFmpeg-LICENSE.txt zlib-LICENSE.txt ffmpeg-9.0.2.tar.xz zlib-1.4.tar.gz)
  file(COPY_FILE "${ffmpeg_devkit}/${notice}" "${windows_tool_dir}/${notice}" ONLY_IF_DIFFERENT)
endforeach()
foreach(notice IN ITEMS FFmpeg-Windows-Provenance.txt build_windows_devkit.ps1)
  file(COPY_FILE "${CMAKE_CURRENT_LIST_DIR}/${notice}" "${windows_tool_dir}/${notice}" ONLY_IF_DIFFERENT)
endforeach()
