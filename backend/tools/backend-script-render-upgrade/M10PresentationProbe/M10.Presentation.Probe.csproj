<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
    <MakoMediaEnvelopeEnabled>true</MakoMediaEnvelopeEnabled>
    <MakoMediaPresentationEnabled>true</MakoMediaPresentationEnabled>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/MakoKaraGenerator.Media/MakoKaraGenerator.Media.csproj" />
    <ProjectReference Include="../../../src/MakoKaraGenerator.Processes/MakoKaraGenerator.Processes.csproj" />
  </ItemGroup>
  <Import Project="../../../build/MakoMediaEnvelope.Native.targets" />
  <Import Project="../../../build/MakoMediaPresentation.Native.targets" />
</Project>
