<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>MakoKaraGenerator.Backend.Hosting.Tests</RootNamespace>
  </PropertyGroup>
  <!-- 真实媒体特征分析测试需要与 Server 相同的 media-tools/ 部署。 -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <MakoMediaEnvelopeEnabled>true</MakoMediaEnvelopeEnabled>
    <MakoMediaPresentationEnabled>true</MakoMediaPresentationEnabled>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <ProjectReference Include="../../src/MakoKaraGenerator.Backend.Hosting/MakoKaraGenerator.Backend.Hosting.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Shared/*.cs" LinkBase="Shared" />
    <None Include="../MakoKaraGenerator.Backend.Worker.Tests/Fixtures/AudioPreparationBaseline/m4a*.input;../MakoKaraGenerator.Backend.Worker.Tests/Fixtures/AudioPreparationBaseline/ogg*.input"
          Link="Fixtures/AudioPreparationBaseline/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="../../build/MakoMediaEnvelope.Native.targets" />
  <Import Project="../../build/MakoMediaPresentation.Native.targets" />
</Project>
