{
  "name": "makokara-generator-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "setup": "node scripts/pnpm-run.mjs --dir frontend install --frozen-lockfile",
    "build": "node scripts/app.mjs build",
    "build:desktop": "node scripts/app.mjs build:desktop",
    "desktop": "node scripts/app.mjs desktop",
    "package:appimage": "node scripts/package-appimage.mjs",
    "package:windows": "node scripts/package-windows.mjs",
    "start": "node scripts/app.mjs start",
    "dev": "node scripts/app.mjs dev",
    "test:unit": "node scripts/pnpm-run.mjs --dir frontend test:unit",
    "test:launcher": "node --experimental-test-module-mocks --test tests/launcher.test.mjs",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "smoke:glow": "node frontend/scripts/glow-smoke.mjs",
    "smoke:layout": "node scripts/layout-check.mjs",
    "smoke:desktop": "node scripts/desktop-smoke.mjs",
    "smoke:desktop-library": "node scripts/desktop-library-smoke.mjs"
  }
}
