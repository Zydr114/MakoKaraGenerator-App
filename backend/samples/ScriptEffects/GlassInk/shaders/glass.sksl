uniform float timeSeconds;
uniform float refractionPx;
uniform float frequencyHz;
uniform float highlight;
uniform float opacity;
uniform shader background;
uniform shader coverage;
half4 main(float2 p) {
    float phase = 6.28318530718 * frequencyHz * timeSeconds;
    // Each component is scaled so the vector length never exceeds refractionPx.
    float2 offset = 0.70710678 * refractionPx * float2(sin(0.075 * p.y + phase), cos(0.055 * p.x - phase));
    half4 sampled = background.eval(p + offset);
    float3 straight = sampled.a > 0.0001 ? float3(sampled.rgb) / float(sampled.a) : float3(0.0);
    float shine = highlight * (0.5 + 0.5 * sin(0.075 * p.x - 0.055 * p.y + phase));
    float3 lit = clamp(straight + float3(shine), 0.0, 1.0);
    float alpha = clamp(float(coverage.eval(p).a), 0.0, 1.0) * opacity * float(sampled.a);
    return half4(lit * alpha, alpha);
}
