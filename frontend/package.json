{
  "name": "makokara-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "node scripts/dev-backend.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration --no-file-parallelism --test-timeout=180000 --hook-timeout=180000",
    "test": "pnpm test:unit && pnpm test:integration",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "smoke:editor": "node scripts/editor-smoke.mjs",
    "smoke:appearance": "node scripts/appearance-smoke.mjs",
    "smoke:orchestration": "node scripts/orchestration-smoke.mjs",
    "smoke:project": "node scripts/project-smoke.mjs",
    "smoke:render": "node scripts/render-device-smoke.mjs",
    "smoke:lyrics": "node scripts/lyrics-smoke.mjs",
    "smoke:library": "node scripts/library-smoke.mjs",
    "smoke:author": "node scripts/author-smoke.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "@material/material-color-utilities": "^0.4.0",
    "react": "^19.3.0",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@material-symbols/svg-400": "^0.48.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
