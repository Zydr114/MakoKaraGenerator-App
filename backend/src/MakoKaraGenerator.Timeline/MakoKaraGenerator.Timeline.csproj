<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MakoKaraGenerator.Timeline</RootNamespace>
    <AssemblyName>MakoKaraGenerator.Timeline</AssemblyName>
  </PropertyGroup>

  <!--
    时间轴的几何与映射层（docs/roadmap.md §3.1 的 MakoKaraGenerator.Timeline）。

    硬性约束：本程序集不引用 Avalonia（roadmap §3.2 的依赖方向）。
    时间↔像素的映射必须能脱离 UI 被单元测试直接验证——
    "标尺、波形、Token 块必须对齐"这条要求就是靠这里保证的，
    而不是靠在控件里调像素调出来。详见 docs/decisions.md ADR-0011。
  -->
  <ItemGroup>
    <ProjectReference Include="../MakoKaraGenerator.Core/MakoKaraGenerator.Core.csproj" />
  </ItemGroup>

</Project>
