{
  "packageVersion": 1,
  "packageId": "demo.advanced",
  "name": "歌词高级效果示例",
  "version": "1.0.0",
  "sdkVersion": "1.0.0",
  "shaderProfile": "skia-raster-3.119.4-v1",
  "files": [
    { "path": "src/WordEmphasis.cs", "role": "csharp", "sha256": "<由真实文件计算的64位十六进制>" },
    { "path": "shaders/glass.sksl", "role": "shader", "sha256": "<由真实文件计算的64位十六进制>" },
    { "path": "shaders/glass.program.json", "role": "shaderProgram", "sha256": "<由真实文件计算的64位十六进制>" },
    { "path": "graphs/glass.graph.json", "role": "graph", "sha256": "<由真实文件计算的64位十六进制>" }
  ],
  "parameters": [
    { "id": "peakScale", "type": "number", "label": "最大放大比例", "default": 1.25, "min": 1.0, "max": 4.0, "unit": "倍" },
    { "id": "returnUs", "type": "duration", "label": "回落时长", "default": 120000, "min": 0, "max": 2000000, "unit": "us" },
    { "id": "backgroundSource", "type": "enum", "label": "玻璃背景来源", "default": "media", "values": [ { "value": "media", "label": "仅背景媒体" }, { "value": "backdrop", "label": "目标后方已合成内容" } ] },
    { "id": "blurPx", "type": "number", "label": "模糊半径", "default": 8.0, "min": 0.0, "max": 64.0, "unit": "canvasPx" }
  ],
  "exports": [
    {
      "id": "word-emphasis", "kind": "controller", "name": "逐字强调", "entryType": "WordEmphasis",
      "parameters": [ "peakScale", "returnUs" ],
      "bindingKinds": [ "project", "branch", "lines", "tokens", "clips", "node" ],
      "outputs": [ { "id": "scale", "kind": "VisualTransform", "target": "tokenFamily", "requires": [], "dependsOn": [] } ]
    },
    {
      "id": "glass-ink", "kind": "material", "name": "玻璃文字／描边", "graph": "graphs/glass.graph.json",
      "parameters": [ "backgroundSource", "blurPx" ], "regions": [ "fill", "stroke" ],
      "fallback": { "kind": "solid", "color": "#4C8DFFFF" },
      "outputs": [ { "id": "ink", "kind": "ImageGraph", "target": "region", "requires": [ "RuntimeShader", "Coverage", "SelectedBackground" ], "dependsOn": [], "bypass": { "kind": "materialFallback", "mapping": "identity" } } ]
    }
  ]
}
