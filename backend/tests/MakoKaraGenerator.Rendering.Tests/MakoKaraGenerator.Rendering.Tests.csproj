<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MakoKaraGenerator.Rendering.Tests</RootNamespace>
    <AssemblyName>MakoKaraGenerator.Rendering.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../samples/ScriptEffects/Examples/EventBurst.cs" Link="script-samples/EventBurst.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../samples/ScriptEffects/CursorTrail/**/*" Link="effect-sources/CursorTrail/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../samples/ScriptEffects/WordEmphasis/**/*" Link="effect-packages/WordEmphasis/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../Shared/*.cs" LinkBase="Shared" />
    <Compile Include="../Shared/Rendering/TimedRubyFixture.cs" Link="Shared/TimedRubyFixture.cs" />
    <Compile Include="../Shared/Rendering/RubySpacingFixture.cs" Link="Shared/RubySpacingFixture.cs" />
    <Compile Include="../Shared/Rendering/RubyLegacyBaselineProbe.cs" Link="Shared/RubyLegacyBaselineProbe.cs" />
    <None Update="Fixtures/ruby-legacy-baseline.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../samples/ScriptEffects/RepeatEmphasis/src/RepeatEmphasis.cs" Link="script-samples/RepeatEmphasis.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../samples/ScriptEffects/WordEmphasis/src/WordEmphasis.cs" Link="script-samples/WordEmphasis.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    渲染层测试横跨三个项目：抽象（快照 / 目标 / 帧）、文字布局（ShapedLine）、
    Skia 实现（整形引擎 + 字体回退）。测试按"关注点"而不是按产品项目组织，
    因此一个测试项目覆盖这三者。
  -->
  <ItemGroup>
    <ProjectReference Include="../../src/MakoKaraGenerator.Core/MakoKaraGenerator.Core.csproj" />
    <ProjectReference Include="../../src/MakoKaraGenerator.Text/MakoKaraGenerator.Text.csproj" />
    <ProjectReference Include="../../src/MakoKaraGenerator.Rendering.Abstractions/MakoKaraGenerator.Rendering.Abstractions.csproj" />
    <ProjectReference Include="../../src/MakoKaraGenerator.Rendering.Skia/MakoKaraGenerator.Rendering.Skia.csproj" />
    <ProjectReference Include="../../samples/TechnicalSpike/MakoKaraGenerator.Spike.csproj" />
    <ProjectReference Include="../../src/MakoKaraGenerator.Scripting/MakoKaraGenerator.Scripting.csproj" />
    <ProjectReference Include="../../src/MakoKaraGenerator.Media/MakoKaraGenerator.Media.csproj" />
  </ItemGroup>

</Project>
