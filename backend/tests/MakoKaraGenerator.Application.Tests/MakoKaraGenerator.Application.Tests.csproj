<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>MakoKaraGenerator.Application.Tests</RootNamespace>
    <AssemblyName>MakoKaraGenerator.Application.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/*.cs" LinkBase="Shared" />
    <None Include="../Fixtures/ScriptEffectsV2/WordEmphasis/**/*" Link="effect-packages-v2/WordEmphasis/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Layout regression compares actual pixels; only this test project references Skia. -->
    <ProjectReference Include="../../src/MakoKaraGenerator.Rendering.Skia/MakoKaraGenerator.Rendering.Skia.csproj" />
    <ProjectReference Include="../../src/MakoKaraGenerator.Application/MakoKaraGenerator.Application.csproj" />
    <ProjectReference Include="../MakoKaraGenerator.Library.Worker/MakoKaraGenerator.Library.Worker.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyLibraryWorker" AfterTargets="Build">
    <MSBuild Projects="$(MSBuildThisFileDirectory)../MakoKaraGenerator.Library.Worker/MakoKaraGenerator.Library.Worker.csproj" Targets="GetTargetPath" BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_LibraryWorkerAssembly" />
    </MSBuild>
    <PropertyGroup><_LibraryWorkerDirectory>@(_LibraryWorkerAssembly->'%(RootDir)%(Directory)')</_LibraryWorkerDirectory></PropertyGroup>
    <ItemGroup><_LibraryWorkerFiles Include="$(_LibraryWorkerDirectory)*" /></ItemGroup>
    <Copy SourceFiles="@(_LibraryWorkerFiles)" DestinationFolder="$(OutDir)library-worker" SkipUnchangedFiles="true" />
  </Target>
</Project>
